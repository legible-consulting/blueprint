# Names only. Every value lives in Vercel (per environment), in the repository's Actions secrets
# and variables, or in a local .env.local that git never sees. The note above each name and the
# [environments] suffix are the contract
# ({% if database == 'neon' %}.icm/database/CONTEXT.md{% if uat %}, .icm/uat/CONTEXT.md{% endif %}{% else %}.icm/uat/CONTEXT.md{% endif %}). Add the application's own names below.
{%- if database == 'neon' %}

# The Neon connection string, pooled. On Vercel: production's on Production, the base's on
# Preview{% if uat %} and uat{% endif %}, and a pull request's own on Preview for its git branch, set by preview-db.sh.
{% if uat %}# In Actions: production's direct string, read by promote.yml's migration only.
{% endif %}# Locally: a branch of your own, never production's.  [production,preview,{% if uat %}uat,ci,{% endif %}development]
DATABASE_URL=
# The direct (unpooled) string of the same branch, for the migrations at build.  [production,preview{% if uat %},uat{% endif %}]
DATABASE_URL_UNPOOLED=
# 1 on a pull request's own branch on Preview, set by preview-db.sh only. The build of {% if uat %}uat{% else %}production{% endif %}
# migrates by VERCEL_TARGET_ENV. Never Preview for all branches.  [preview]
MIGRATE_AT_BUILD=
{%- endif %}

# Read by .icm/scripts/*.sh and the workflows, never by the application. No name here names a
# project: the scripts find {% if uat %}the UAT projects, the Vercel projects of this repository with the
# custom environment uat{% else %}the Vercel projects of this repository by their git link{% endif %}{% if database == 'neon' %}, and the Neon project of the base by its name,
# {% if uat %}uat-{% endif %}{{ slug }}{% endif %}.  [ci,shell]
VERCEL_TOKEN=
VERCEL_TEAM=
{%- if database == 'neon' %}
NEON_API_KEY=
{%- endif %}
