{#- The deny list names each secret env file, so .env.example stays readable: the kickoff, the
UAT setup and the written-once list tell a session to read it. A glob such as .env.* also
matches .env.example. -#}
{#- The allow list is build-only, because a workspace has no .icm/scripts/. It names the two
scripts that merge, so that auto mode runs them after the tick or Jamie's word. Each script
carries its gate and refuses without it. No rule allows a raw `gh api` merge or a branch delete. -#}
{
  "permissions": {
{%- if not workspace %}
    "allow": [
      "Bash(.icm/scripts/merge.sh *)",
      "Bash(.icm/scripts/release.sh)",
      "Bash(.icm/scripts/release.sh *)"
    ],
{%- endif %}
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.preview)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/.env.vercel)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
{%- if not workspace %}
{#- Two build-only hooks. A workspace never registers them. The router names the contract for
each prompt. The session board prints the open tickets at session start. #}
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/route-request.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
{%- endif %}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-local-checks.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-git-writes.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-plaintext-secrets.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-plaintext-secrets.sh\""
          }
        ]
      }
    ]
  }
}
