# Names only. Every value lives in Vercel (per environment), in the repository's Actions secrets
# and variables, or in a local .env.local that git never sees. The note above each name and the
# [environments] suffix are the contract (.icm/uat/CONTEXT.md). Add the application's own names below.

# The Neon connection string, pooled. On Vercel the Neon integration sets Production's and each
# preview's. uat-db.sh sets the `uat` environment's. In Actions: production's direct string, read
# by promote.yml's migration only. Locally: a branch of your own, never production's.  [production,preview,uat,ci,development]
DATABASE_URL=
# The direct (unpooled) string of the same branch, for the migrations at build.  [production,preview,uat]
DATABASE_URL_UNPOOLED=

# Read by .icm/scripts/*.sh and the workflows, never by the application.  [ci,shell]
VERCEL_TOKEN=
VERCEL_TEAM=
VERCEL_PROJECT=
NEON_API_KEY=
NEON_PROJECT_ID=
