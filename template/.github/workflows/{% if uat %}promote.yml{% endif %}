# promote: the promotion to production (CI is truth; never run locally). The contract is
# .icm/uat/CONTEXT.md. Jamie publishes the promotion Release that promote.sh approve drafted, and
# this workflow runs on that publish: the Release's notes name the commit (`- promote-sha:`),
# production is migrated, then the staged production build of that commit is promoted, then
# production is read once. A Release without that line is not a promotion, and the run ends
# green and says so. Each job needs the one before it, so a failure leaves production untouched.
name: promote

on:
  release:
    types: [published]

permissions:
  contents: read

concurrency:
  group: promote
  cancel-in-progress: false

defaults:
  run:
    shell: bash

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      sha: ${{ steps.record.outputs.sha }}
      tag: ${{ github.event.release.tag_name }}
    steps:
      - name: Is this Release a promotion?
        id: record
        env:
          BODY: ${{ github.event.release.body }}
          TAG: ${{ github.event.release.tag_name }}
          PRERELEASE: ${{ github.event.release.prerelease }}
          EVENT_SHA: ${{ github.sha }}
        run: |
          sha=""
          marked="$(printf '%s\n' "$BODY" | sed -nE 's/^- promote-sha: ([0-9a-f]{40})[[:space:]]*$/\1/p' | head -n1)"
          if [ "$PRERELEASE" = true ]; then
            echo "::notice::$TAG is a prerelease: not a promotion"
          elif [ -z "$marked" ]; then
            echo "::notice::$TAG carries no promote-sha line: not a promotion (a release-please Release, or one made by hand)"
          elif [ "$marked" != "$EVENT_SHA" ]; then
            echo "::error::$TAG names ${marked:0:7} but its tag is at ${EVENT_SHA:0:7}: refusing to promote a commit the record does not name"
            exit 1
          else
            sha="$marked"
            echo "promotion $TAG at ${sha:0:7}: migrate production, then promote"
          fi
          echo "sha=$sha" >> "$GITHUB_OUTPUT"

  migrate:
    # db:migrate, then db:verify, against production. A repository without the scripts skips
    # them (--if-present). A missing DATABASE_URL fails here, before anything is promoted.
    needs: release
    if: needs.release.outputs.sha != ''
    runs-on: ubuntu-latest
    timeout-minutes: 20
    concurrency:
      group: migrate-production
      cancel-in-progress: false
    env:
      DATABASE_URL: ${{ secrets.DATABASE_URL }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ needs.release.outputs.sha }}
          persist-credentials: false
      - name: The connection string is set
        run: |
          [ -n "$DATABASE_URL" ] || { echo "::error::the repository secret DATABASE_URL is not set: production cannot be migrated, nothing is promoted"; exit 1; }
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        if: hashFiles('package.json') != ''
        with:
          node-version: 22
      - name: Migrate production, then verify
        if: hashFiles('package.json') != ''
        run: |
          if [ -f pnpm-lock.yaml ]; then
            corepack enable
            pnpm install --frozen-lockfile
            run() { pnpm run --if-present "$1"; }
          else
            npm ci
            run() { npm run --if-present "$1"; }
          fi
          run db:migrate
          run db:verify

  promote:
    needs: [release, migrate]
    if: needs.release.outputs.sha != ''
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
      VERCEL_TEAM: ${{ vars.VERCEL_TEAM }}
      VERCEL_PROJECT: ${{ vars.VERCEL_PROJECT || github.event.repository.name }}
      SHA: ${{ needs.release.outputs.sha }}
      TAG: ${{ needs.release.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ needs.release.outputs.sha }}
          persist-credentials: false
      - name: Promote the staged production build of the release
        run: |
          # shellcheck source=/dev/null
          source .icm/scripts/lib/vercel.sh
          vercel_require "promoting $TAG"
          deadline=$((SECONDS + 900))
          while :; do
            dep="$(vercel_deployment production "$SHA")"
            state="$(printf '%s' "$dep" | jq -r '.state // .readyState // empty')"
            case "$state" in
              READY) break ;;
              ERROR|CANCELED) die "the production build of ${SHA:0:7} is $state: nothing to promote, production untouched" ;;
            esac
            [ "$SECONDS" -lt "$deadline" ] || die "no READY production build of ${SHA:0:7} after fifteen minutes (${state:-none}): is Auto-assign off, and did its merge build? Production untouched"
            echo "production build of ${SHA:0:7}: ${state:-not found yet}. Waiting."
            sleep 20
          done
          id="$(printf '%s' "$dep" | jq -r '.uid // .id')"
          if [ "$(vercel_production_current)" = "$id" ]; then
            echo "$id is current already: nothing to promote"
            exit 0
          fi
          code="$(vercel_promote "$id")"
          case "$code" in
            2??) echo "promote requested for $id (HTTP $code)" ;;
            *) die "POST promote answered HTTP $code: production unchanged" ;;
          esac
          for _ in $(seq 1 60); do
            [ "$(vercel_production_current)" = "$id" ] && break
            sleep 10
          done
          [ "$(vercel_production_current)" = "$id" ] || die "$id is not current after ten minutes: read the project in Vercel"
          echo "$TAG is current: $id"
      - name: Read production once
        run: |
          # shellcheck source=/dev/null
          source .icm/scripts/lib/vercel.sh
          while IFS= read -r d; do
            [ -n "$d" ] || continue
            code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "https://$d/" || echo 000)"
            echo "https://$d/ answered HTTP $code"
          done < <(vercel_production_domains)
