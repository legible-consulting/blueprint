# neon-cleanup: a pull request closes, and its own database, the Neon branch preview/<branch>,
# is deleted with its three variables on Vercel Preview (CI is truth; never run locally).
# preview-db.yml made the branch when the pull request changed a migration. A pull request that
# made no branch: nothing is deleted. Nothing else is named: never the base. The contract is
# .icm/database/CONTEXT.md.
name: neon-cleanup

on:
  pull_request:
    types: [closed]

permissions:
  contents: read

concurrency:
  group: neon-cleanup-${{ github.event.pull_request.number }}
  cancel-in-progress: false

defaults:
  run:
    shell: bash

jobs:
  cleanup:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      # No variable names a project. preview-db.sh finds the Neon project of the base by its name
      # and the Vercel projects by their git link to this repository.
      NEON_API_KEY: ${{ secrets.NEON_API_KEY }}
      VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
      VERCEL_TEAM: ${{ vars.VERCEL_TEAM }}
      GH_REPO: ${{ github.repository }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Delete preview/<branch> and its variables when they exist
        run: |
          out="$(bash .icm/scripts/preview-db.sh delete "$GITHUB_HEAD_REF")"
          echo "$out"
          echo "Neon cleanup: $(tail -n1 <<<"$out")" >> "$GITHUB_STEP_SUMMARY"
