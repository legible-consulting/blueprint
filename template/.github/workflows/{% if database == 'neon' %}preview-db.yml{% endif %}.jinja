# preview-db: a pull request that changes a migration gets its own database, the Neon branch
# preview/<branch>, cut from the base with its data (CI is truth; never run locally). The
# branch's three variables go on Vercel Preview, scoped to the git branch, and the branch's
# newest preview is built again. A pull request with no migration reads the base. A second run
# changes nothing. neon-cleanup.yml deletes the branch. The contract is .icm/database/CONTEXT.md.
name: preview-db

on:
  pull_request:
    types: [opened, synchronize, reopened]
    paths: ["{{ migrations_path }}/**"]

permissions:
  contents: read
{% raw %}
concurrency:
  group: preview-db-${{ github.event.pull_request.number }}
  cancel-in-progress: false

defaults:
  run:
    shell: bash

jobs:
  create:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      # No variable names a project. preview-db.sh finds the Neon project of the base by its name
      # and the Vercel projects by their git link to this repository.
      NEON_API_KEY: ${{ secrets.NEON_API_KEY }}
      VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
      VERCEL_TEAM: ${{ vars.VERCEL_TEAM }}
      GH_REPO: ${{ github.repository }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Create preview/<branch> and its variables
        run: |
          out="$(bash .icm/scripts/preview-db.sh create "$GITHUB_HEAD_REF")"
          echo "$out"
          echo "Preview database: $(tail -n1 <<<"$out")" >> "$GITHUB_STEP_SUMMARY"
{% endraw %}
